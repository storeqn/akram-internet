// تُضبط الأسرار في Script Properties فقط، وليس في هذا الملف.
var HEADERS = ['id','createdAt','name','phone','province','district','area','landmark','service','notes','maps','lat','lng','status','internalNotes','updatedAt','fingerprint'];
var STATUSES = ['جديد','تم التواصل','قيد التجهيز','مكتمل','ملغي'];
function output_(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);}
function sheet_(){var props=PropertiesService.getScriptProperties();var id=props.getProperty('SHEET_ID');if(!id)throw new Error('Missing SHEET_ID');var book=SpreadsheetApp.openById(id);var s=book.getSheetByName('Orders');if(!s){s=book.insertSheet('Orders');s.appendRow(HEADERS);s.setFrozenRows(1);}var actual=s.getRange(1,1,1,HEADERS.length).getValues()[0];if(actual.join('|')!==HEADERS.join('|'))throw new Error('Schema mismatch');return s;}
function safe_(v){var s=v==null?'':String(v);return /^[=+\-@\t\r\n]/.test(s)?"'"+s:s;}
function hash_(v){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,v).map(function(b){return ('0'+(b&255).toString(16)).slice(-2);}).join('');}
function row_(r){var o={};HEADERS.forEach(function(k,i){o[k]=r[i] instanceof Date?r[i].toISOString():r[i];});o.lat=o.lat===''?null:Number(o.lat);o.lng=o.lng===''?null:Number(o.lng);delete o.fingerprint;return o;}
function doGet(){return output_({ok:false,error:'Method not allowed'});}
function doPost(e){var lock=LockService.getScriptLock();try{var input=JSON.parse(e.postData.contents);var secret=PropertiesService.getScriptProperties().getProperty('API_SECRET');if(!secret||secret.length<32||typeof input.secret!=='string'||hash_(input.secret)!==hash_(secret))return output_({ok:false,error:'Unauthorized'});lock.waitLock(20000);var s=sheet_(),count=s.getLastRow()-1;
if(input.action==='submit'){var o=input.order;if(!o||!/^[0-9a-f-]{36}$/i.test(o.id))throw new Error('Invalid order');var fields=['name','phone','province','district','area','landmark','service','notes','maps'];fields.forEach(function(k){if(typeof o[k]!=='string'||o[k].length>1000)throw new Error('Invalid field');});if(o.name.trim().split(/\s+/).length<3||!/^07[3-9]\d{8}$/.test(o.phone)||!o.province||!o.district||!o.area||!o.landmark)throw new Error('Invalid fields');if(['إنترنت منزلي','إنترنت ضوئي','مؤسسات وشركات ودوائر حكومية'].indexOf(o.service)<0)throw new Error('Invalid service');if((o.lat!==null||o.lng!==null)&&(typeof o.lat!=='number'||typeof o.lng!=='number'||!isFinite(o.lat)||!isFinite(o.lng)||Math.abs(o.lat)>90||Math.abs(o.lng)>180))throw new Error('Invalid location');
var fingerprint=hash_(JSON.stringify(fields.map(function(k){return o[k];}).concat([o.lat,o.lng])));if(count){var ids=s.getRange(2,1,count,1).getValues();for(var i=0;i<ids.length;i++)if(ids[i][0]===o.id){var existing=s.getRange(i+2,17).getValue();if(existing!==fingerprint)return output_({ok:false,error:'تعارض رقم الطلب. أعد تحميل الصفحة.'});return output_({ok:true,id:o.id,duplicate:true});}var recent=s.getRange(Math.max(2,s.getLastRow()-99),1,Math.min(count,100),HEADERS.length).getValues();for(var j=recent.length-1;j>=0;j--)if(recent[j][16]===fingerprint&&Date.now()-new Date(recent[j][1]).getTime()<300000)return output_({ok:true,id:recent[j][0],duplicate:true});}
var now=new Date().toISOString();var record={id:o.id,createdAt:now,status:'جديد',internalNotes:'',updatedAt:now,fingerprint:fingerprint};fields.forEach(function(k){record[k]=o[k];});record.lat=o.lat;record.lng=o.lng;var range=s.getRange(s.getLastRow()+1,1,1,HEADERS.length);range.setNumberFormat('@');range.setValues([HEADERS.map(function(k){return safe_(record[k]);})]);SpreadsheetApp.flush();return output_({ok:true,id:o.id,duplicate:false});}
if(input.action==='list'){var limit=Math.min(count,1000);var orders=limit?s.getRange(s.getLastRow()-limit+1,1,limit,HEADERS.length).getValues().reverse().map(row_):[];return output_({ok:true,orders:orders,truncated:count>limit});}
if(input.action==='update'){if(STATUSES.indexOf(input.status)<0||typeof input.internalNotes!=='string'||input.internalNotes.length>2000)throw new Error('Invalid update');var all=count?s.getRange(2,1,count,1).getValues():[];for(var n=0;n<all.length;n++)if(all[n][0]===input.id){s.getRange(n+2,14,1,3).setValues([[input.status,safe_(input.internalNotes),new Date().toISOString()]]);SpreadsheetApp.flush();return output_({ok:true});}return output_({ok:false,error:'الطلب غير موجود.'});}
return output_({ok:false,error:'Unknown action'});
}catch(error){return output_({ok:false,error:'تعذر تنفيذ العملية. تحقق من إعدادات الخدمة وأعد المحاولة.'});}finally{if(lock.hasLock())lock.releaseLock();}}
